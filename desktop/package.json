{
  "name": "tren-desktop",
  "version": "0.12.1",
  "private": true,
  "description": "VEYRA \u2014 Your AI. Your computer. Your rules.",
  "author": "VEYRA",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "predist": "node build-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.alecjhalpin.tren",
    "productName": "VEYRA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "runtime.cjs",
      "package.json",
      "preload.cjs",
      "bootstrap.cjs",
      "profile.cjs",
      "assets/veyra-icon.png"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "VEYRA-Desktop-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "VEYRA",
      "include": "installer/options.nsh",
      "runAfterFinish": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alecjhalpin",
        "repo": "Veyra"
      }
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/python",
        "to": "python"
      },
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/tool-runtime",
        "to": "tool-runtime"
      },
      {
        "from": "resources/tool-runtime/node_modules",
        "to": "tool-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/node/node_modules",
        "to": "node/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "executableName": "TREN"
  }
}
